# BoxAI server-side credentials shared by image generation and template text models.
# Template organizer fallback order: deepseek-v4.1-flash -> gemini-3.8-flash -> gpt-6-luna.
# Never prefix the key with NEXT_PUBLIC_.
BOXAI_BASE_URL=https://you-box.com/v1
BOXAI_API_KEY=replace-with-your-boxai-api-key

# Public HTTPS origin used to build the Alipay return URL.
APP_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
# Separate AES-GCM key for creator Alipay payout details. Generate at least 32 random characters.
CREATOR_PAYOUT_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# PostgreSQL is required for email login and production account data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zaojing

# Alibaba Cloud DirectMail SMTP for the Chinese mainland.
# Use the exact endpoint shown in DirectMail if your region differs.
EMAIL_SMTP_HOST=smtpdm.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=no-reply@mail.example.com
EMAIL_SMTP_PASSWORD=replace-with-the-sender-address-smtp-password
EMAIL_FROM_ADDRESS=no-reply@mail.example.com
EMAIL_FROM_NAME=造境 Style Lab

# Alipay AI web application payment. Keep private keys server-side only.
# Keep false until PostgreSQL migration and production callbacks are verified.
PAYMENTS_ENABLED=false
ALIPAY_APP_ID=replace-with-your-alipay-app-id
ALIPAY_PRIVATE_KEY=replace-with-your-pkcs1-app-private-key
ALIPAY_PUBLIC_KEY=replace-with-the-alipay-public-key
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Production/public callback must be HTTPS. Leave empty for local parameter validation.
ALIPAY_NOTIFY_URL=
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=

# Vibe Pay "NowPay Direct" quantity package. Keep disabled until charge.query,
# a real purchase return, quota.query and a one-count quota.verify are verified.
NOWPAY_ENABLED=false
NOWPAY_PRODUCT_ID=DIRECT_replace-with-product-id

# Comma-separated email accounts allowed to open the browser admin area.
ADMIN_EMAILS=owner@example.com
# Optional server-to-server credential for order closing and refund endpoints.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
