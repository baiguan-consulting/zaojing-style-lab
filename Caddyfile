{
	admin off
}

picture.baiguan-consulting.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Uploaded template images are created at runtime and are not part of Next.js' build manifest.
	handle /uploads/* {
		root * /srv
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
